# Cloudflare Workers/Pages static-assets headers.
# .htaccess only applies on Apache/LiteSpeed (Hostinger) — this file is the
# equivalent for the Cloudflare deployment (catering-tools-by-deecstudio).
#
# Strict-Transport-Security forces HTTPS for a full year on every future
# visit, including subdomains — closes the small window where a visitor
# typing the bare domain (no https://) could have their very first request
# go out over plain HTTP before Cloudflare's redirect kicks in. No
# "; preload" — that submits the domain to browsers' hardcoded preload
# list, which is far harder to reverse than this header alone.
#
# script-src allowlists ONE specific inline script by its SHA-256 hash
# (the Whop tracking pixel in index.html's <head>) instead of using
# 'unsafe-inline' — every OTHER inline script stays blocked, which is
# what makes this site's XSS surface a non-issue. Edit that snippet and
# this hash goes stale (recompute it and update here + .htaccess, or the
# pixel silently stops loading). https://t.whop.tw is that pixel's own
# domain (loads s.js, sends tracking events) — a different Whop subdomain
# from the checkout iframe's whop.com.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://whop.com")
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Vj0ZQI6HmRlgG8PCxGgAq25M62GE2IwjbyWbU26rh4Y=' https://t.whop.tw; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data:; frame-src https://whop.com; connect-src 'self' https://whop.com https://t.whop.tw; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.html
  Cache-Control: no-cache, must-revalidate

# stale-while-revalidate/stale-if-error on top of no-cache/must-revalidate:
# if a revalidation request gets cut short (seen on iOS Safari after 2-3
# rapid reloads — it can cancel in-flight requests instead of retrying),
# the browser is explicitly allowed to fall back to the last good cached
# copy instead of ending up with no stylesheet/script at all, which is
# what was producing an unstyled-HTML flash on repeated fast refreshes.
/*.css
  Cache-Control: no-cache, must-revalidate, stale-while-revalidate=86400, stale-if-error=86400

/*.js
  Cache-Control: no-cache, must-revalidate, stale-while-revalidate=86400, stale-if-error=86400

/assets/*
  Cache-Control: public, max-age=2592000
